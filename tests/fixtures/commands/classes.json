    {"class": "download to stdout", "command": "curl -sL https://example.com -o -"},
    {"class": "archive listing", "command": "unzip -l bundle.zip"},
    {"class": "archive to stdout", "command": "unzip -p doc.docx docProps/core.xml | head"},
    {"class": "archive listing", "command": "tar -tzf bundle.tgz | head"},
    {"class": "git listing", "command": "git stash list | head -3"},
    {"class": "git listing", "command": "git stash show --stat 'stash@{0}'"},
    {"class": "git listing", "command": "git tag --list 'v*'"},
    {"class": "git listing", "command": "git tag"},
    {"class": "git listing", "command": "git reflog -5 --date=iso"},
    {"class": "git listing", "command": "git reflog show main"},
    {"class": "git listing", "command": "git worktree list"},
    {"class": "git listing", "command": "git branch --list 'topic/*' -v"},
    {"class": "git listing", "command": "git branch -r --contains abc1234"},
    {"class": "git listing", "command": "git remote -v"},
    {"class": "git listing", "command": "git config --get core.autocrlf"},
    {"class": "git listing", "command": "git config core.autocrlf"},
    {"class": "git dry run", "command": "git fetch --dry-run"},
    {"class": "git dry run", "command": "git clean -n"},
    {"class": "inline python that only reads", "command": "python3 -c \"import json; print(json.load(open('a.json'))['name'])\""},
    {"class": "inline python that only reads", "command": "python3 - <<'EOF'\nfor line in open('a.log', encoding='utf-8'):\n    if 'error' in line:\n        print(line.rstrip())\nEOF"},
    {"class": "inline python that only reads", "command": "python3 -c \"s = 'a,b'; print(s.replace(',', ' '))\""},
    {"class": "inline python that only reads", "command": "python3 -c \"import re; print(re.sub(r'\\s+', ' ', open('a.txt').read()))\""},
    {"class": "inline python that only reads", "command": "python3 -c \"import urllib.request; print(urllib.request.urlopen('http://localhost:3000').status)\""},
    {"class": "inline python with escapes", "command": "python3 -c \"print('\\$HOME')\""},
    {"class": "inline javascript that only reads", "command": "node -e \"console.log(require('fs').readFileSync('package.json', 'utf8').length)\""},
    {"class": "inline applescript that only reads", "command": "osascript -e 'tell application \"Finder\" to get name of front window'"},
